# Public Supabase browser configuration
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only Supabase privileged key for trusted operations. Never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# Server-only AI integration. Never prefix this with NEXT_PUBLIC_.
OPENAI_API_KEY=
OPENAI_MODEL=

# Development only. Production refuses fixture generation unless explicitly enabled.
FETCH_ENABLE_DEV_FIXTURE=true

# Optional external OAuth credentials for Supabase CLI
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=
SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET=
