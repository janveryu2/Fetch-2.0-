# Public Supabase browser configuration
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only Supabase privileged key for trusted operations. Never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# Server-only AI integration (never prefix with NEXT_PUBLIC_)
GEMINI_API_KEY=
GEMINI_STUDYPACK_MODEL=gemini-3.7-flash

GROQ_API_KEY=
GROQ_TUTOR_MODEL=openai/gpt-oss-120b

# Development only. Production refuses fixture generation unless explicitly enabled.
FETCH_ENABLE_DEV_FIXTURE=true
